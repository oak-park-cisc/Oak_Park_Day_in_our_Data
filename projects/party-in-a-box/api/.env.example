# Copy to api/.env and fill in. api/.env is git-ignored — never commit it.
# Claude API key for the Traffic planner's AI summary (POST /v1/ai/explain).
# Leave blank to use the labelled templated summary instead.
# In CI/deploys this comes from the GitHub secret ANTHROPIC_API_KEY; locally, paste it here.
ANTHROPIC_API_KEY=
# Model for the AI summary.
ANTHROPIC_MODEL=claude-sonnet-5-5
DATABASE_URL=postgresql+psycopg://party:party@localhost:5433/partyinabox
CORS_ORIGINS=https://dsvs12.github.io,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
PUBLIC_SITE_URL=https://dsvs12.github.io/block-party-in-a-box/
AUTH_MODE=dev
# TODAY_OVERRIDE=2026-10-03
